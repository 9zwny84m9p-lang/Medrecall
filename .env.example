# MedRecall reads AI credentials on the server only — never in frontend code.
#
# Leave these unset to run on the deterministic provider, which is what the demo
# course and the whole Milestone 1 flow use.

# deterministic | anthropic
AI_PROVIDER=deterministic

# Required only when AI_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5
